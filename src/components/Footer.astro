
---
const year = new Date().getFullYear();

const socialLinks = [
  {
    name: 'YouTube',
    url: 'https://www.youtube.com/@trauzanelevator',
    icon: 'YT',
  },
  {
    name: 'Pinterest',
    url: 'https://in.pinterest.com/trauzanelevator/',
    icon: 'P',
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/trauzanelevator/',
    icon: 'IG',
  },
  {
    name: 'Twitter',
    url: 'https://x.com/trauzanelevator/',
    icon: '𝕏',
  },
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/trauzanelevator',
    icon: 'f',
  },
];
---

<!-- FOOTER CTA -->
<section class="footer-cta">
  <div class="container footer-cta-inner">

    <div class="footer-cta-content">
      <span class="eyebrow light">THE NEXT MOVE STARTS HERE</span>

      <h2>
        Make every floor<br />
        <em>feel effortless.</em>
      </h2>

      <p>
        Let's find the right vertical mobility solution for your space.
      </p>
    </div>

    <a class="footer-cta-button" href="/contact/">
      <span>DISCUSS YOUR PROJECT</span>
      <span class="footer-cta-arrow">↗</span>
    </a>

  </div>
</section>


<!-- MAIN FOOTER -->
<footer class="site-footer">

  <div class="container footer-grid">

    <!-- BRAND -->
    <div class="footer-brand">

      <a class="brand brand-light" href="/" aria-label="Trauzan Elevator home">
        <img
          class="footer-logo"
          src="/images/Trauzan_Elevator_Services_Logo-footer.png"
          alt="Trauzan Elevator"
          width="220"
          height="110"
          loading="lazy"
        />
      </a>

      <p>
        Complete lift, elevator and escalator solutions with a commitment
        to safety, dependable performance and thoughtful service.
      </p>

      <span class="footer-brand-tagline">
        YOUR SAFETY, OUR PRIORITY.
      </span>

    </div>


    <!-- EXPLORE -->
    <div class="footer-column">

      <span class="footer-label">EXPLORE</span>

      <a href="/about/">About us</a>
      <a href="/services/">Our services</a>
      <a href="/gallery/">Gallery</a>
      <a href="/contact/">Contact</a>

    </div>


    <!-- CONTACT -->
    <div class="footer-column">

      <span class="footer-label">GET IN TOUCH</span>

      <a href="tel:+919911806270">+91 9911806270</a>
      <a href="tel:+918287573495">+91 8287573495</a>
      <a href="tel:+919711457761">+91 9711457761</a>

      <a href="mailto:Info@trauzanelevator.co.in">
        Info@trauzanelevator.co.in
      </a>

    </div>


    <!-- LOCATION -->
    <div class="footer-column footer-location">

      <span class="footer-label">OUR LOCATION</span>

      <p>
        Plot No. 1-A, 5GF, Ground Floor, Khasra No. 590,
        Sabhapur Extension, North East Delhi – 110094, India.
      </p>

      <a class="text-link" href="/contact/">
        View location <span>↗</span>
      </a>

    </div>

  </div>


  <!-- SOCIAL MEDIA BAR -->
  <div class="container">

    <div class="footer-social-bar">

      <div class="footer-social-info">
        <span class="footer-social-heading">STAY CONNECTED</span>
        <p>Follow our journey, projects and latest updates.</p>
      </div>

      <div class="footer-social-links">

        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit Trauzan Elevator on ${social.name}`}
            title={social.name}
            class="footer-social-link"
          >
            <span class="footer-social-symbol">{social.icon}</span>
            <span class="footer-social-name">{social.name}</span>
            <span class="footer-social-arrow">↗</span>
          </a>
        ))}

      </div>

    </div>

  </div>


  <!-- FOOTER BOTTOM -->
  <div class="container footer-bottom">

    <span>© {year} Trauzan Elevator. All rights reserved.</span>

    <a href="/contact/" class="footer-bottom-link">
      Let's build something reliable <span>↗</span>
    </a>

    <span>DESIGNED FOR SAFETY. BUILT TO LAST.</span>

  </div>

</footer>


<!-- FLOATING CONTACT BUTTONS -->
<div class="floating-contact-buttons">

  <!-- CALL BUTTON -->
  <a
    href="tel:+919911806270"
    class="floating-call-btn"
    aria-label="Call Trauzan Elevator"
    title="Call us"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2
        19.79 19.79 0 0 1-8.63-3.07
        19.5 19.5 0 0 1-6-6
        19.79 19.79 0 0 1-3.07-8.67
        A2 2 0 0 1 4.11 2h3
        a2 2 0 0 1 2 1.72
        c.12.96.36 1.9.72 2.8
        a2 2 0 0 1-.45 2.11L8.11 11.9
        a16 16 0 0 0 6 6l3.27-1.27
        a2 2 0 0 1 2.11.45
        c.9.36 1.84.6 2.8.72
        A2 2 0 0 1 22 16.92Z"
      />
    </svg>
  </a>


  <!-- WHATSAPP BUTTON -->
  <a
    href="https://wa.me/919911806270"
    class="floating-whatsapp-btn"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with Trauzan Elevator on WhatsApp"
    title="WhatsApp us"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.7A8.5 8.5 0 1 1 20.5 11.5Z"
      />
      <path
        d="M8.5 8.5c.5 2.5 2.5 4.5 5 5l1-1 2 1c-.5 1.5-1.5 2-3 1.5-3-1-5.5-3.5-6-6.5-.2-1 .5-2 1.5-2.5l1 2-1.5.5Z"
        class="whatsapp-inner"
      />
    </svg>
  </a>

</div>
