
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'Trauzan Elevator | Lift, Elevator & Escalator Solutions',
  description = 'Trauzan Elevator provides lift installation, elevator repair, maintenance, modernization and escalator services in Delhi and surrounding areas.',
  image = '/images/hero-elevator.svg'
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#101d2b" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />

  <link rel="canonical" href={`https://www.trauzanelevator.co.in${Astro.url.pathname}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://images.unsplash.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://www.trauzanelevator.co.in${image}`} />

  <title>{title}</title>
  <slot name="head" />
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer />

  <script src="../scripts/site.js"></script>
</body>
</html>

<style is:global>
  html {
    overflow-x: clip;
  }

  body {
    overflow-x: clip;
    overflow-y: auto;
  }

  /* Contact information must scroll normally */
  .topline,
  .address-strip {
    position: relative !important;
    top: auto !important;
  }

  /* Only the main navbar stays at the top */
  .site-header {
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
  }
</style>
