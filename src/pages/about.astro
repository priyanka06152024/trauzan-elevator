<script>
  // DOCUMENT VIEWER

 
  // DOCUMENT VIEWER

  const viewer = document.querySelector('[data-document-viewer]');

  if (viewer) {
    const image = viewer.querySelector('[data-viewer-image]');
    const title = viewer.querySelector('[data-viewer-title]');
    const counter = viewer.querySelector('[data-viewer-counter]');
    const progress = viewer.querySelector('[data-viewer-progress]');

    const prev = viewer.querySelector('[data-viewer-prev]');
    const next = viewer.querySelector('[data-viewer-next]');
    const close = viewer.querySelector('[data-viewer-close]');

    // IMPORTANT: Use the same filenames as the documents array.

    const documentData = {
      gst: {
        title: 'GST Registration Certificate',
        pages: [
          '/images/gst1.webp',
          '/images/gst2.webp',
          '/images/gst3.webp',
        ],
      },

      business: {
        title: 'Business Registration Certificate',
        pages: [
          '/images/rc1.webp',
          '/images/rc2.webp',
          '/images/rc3.webp',
        ],
      },

      udyam: {
        title: 'Udyam Registration Certificate',
        pages: [
          '/images/udyam-page-1.webp',
        ],
      },
    };

    let currentDocument = null;
    let currentPage = 0;
    let previousFocus = null;
    let previousOverflow = '';

    function updateViewer() {
      const doc = documentData[currentDocument];

      if (!doc) return;

      image.src = doc.pages[currentPage];
      image.alt = `${doc.title} - Page ${currentPage + 1}`;

      title.textContent = doc.title;

      counter.textContent =
        `PAGE ${String(currentPage + 1).padStart(2, '0')} / ${String(doc.pages.length).padStart(2, '0')}`;

      progress.style.width =
        `${((currentPage + 1) / doc.pages.length) * 100}%`;

      prev.disabled = currentPage === 0;
      next.disabled = currentPage === doc.pages.length - 1;
    }

    function openViewer(id, trigger) {
      if (!documentData[id]) return;

      currentDocument = id;
      currentPage = 0;

      previousFocus = trigger;
      previousOverflow = document.body.style.overflow;

      updateViewer();

      viewer.inert = false;
      viewer.classList.add('is-open');
      viewer.setAttribute('aria-hidden', 'false');

      document.body.style.overflow = 'hidden';

      close.focus();
    }

    function closeViewer() {
      if (!currentDocument) return;

      viewer.classList.remove('is-open');
      viewer.setAttribute('aria-hidden', 'true');
      viewer.inert = true;

      document.body.style.overflow = previousOverflow;

      currentDocument = null;

      if (previousFocus && document.contains(previousFocus)) {
        previousFocus.focus();
      }
    }

    function nextPage() {
      const doc = documentData[currentDocument];

      if (!doc || currentPage >= doc.pages.length - 1) return;

      currentPage++;
      updateViewer();
    }

    function previousPage() {
      if (!currentDocument || currentPage <= 0) return;

      currentPage--;
      updateViewer();
    }

    // OPEN DOCUMENT

    document.querySelectorAll('[data-open-document]').forEach((button) => {
      button.addEventListener('click', () => {
        openViewer(button.dataset.openDocument, button);
      });
    });

    // VIEWER BUTTONS

    close.addEventListener('click', closeViewer);
    next.addEventListener('click', nextPage);
    prev.addEventListener('click', previousPage);

    // CLOSE ON BACKGROUND CLICK

    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) {
        closeViewer();
      }
    });

    // KEYBOARD CONTROLS

    document.addEventListener('keydown', (event) => {
      if (!currentDocument) return;

      if (event.key === 'Escape') closeViewer();
      if (event.key === 'ArrowRight') nextPage();
      if (event.key === 'ArrowLeft') previousPage();
    });
  }

