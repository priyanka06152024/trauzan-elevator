---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Contact Trauzan Elevator | Delhi Lift & Elevator Enquiries" description="Contact Trauzan Elevator for lift installation, elevator repair, maintenance, modernization and escalator enquiries in Delhi.">
<PageHero eyebrow="START A CONVERSATION" title="Let's talk." accent="We're here to help." description="Share your requirements and our team will help you take the next step." image="/images/elevater8.png"/>
<section class="section contact-section"><div class="container contact-layout"><div class="contact-info"><span class="eyebrow">CONTACT DETAILS</span><h2>Good things begin<br/><em>with a conversation.</em></h2><p class="lead">For a new installation, service request or general enquiry, reach out to our team.</p><div class="contact-detail"><small>CALL OUR TEAM</small><a href="tel:+919911806270">+91 9911806270</a><a href="tel:+918287573495">+91 8287573495</a><a href="tel:+919711457761">+91 9711457761</a></div><div class="contact-detail"><small>EMAIL</small><a href="mailto:Trauzanelevator@gmail.com">Trauzanelevator@gmail.com</a><a href="mailto:Info@trauzanelevator.co.in">Info@trauzanelevator.co.in</a></div><div class="contact-detail"><small>VISIT US</small><p>Plot No. 1-A, 5GF, Ground Floor, Khasra No. 590, Nearby N.D. Model Public School, Sabhapur, St. 6, Milan Garden, Chaman Vihar, Gali No. 8, Block A, Sabhapur Extension, North East Delhi – 110094, India.</p></div><a class="button button-dark" href="https://wa.me/919911806270" target="_blank" rel="noopener">Message on WhatsApp <span>↗</span></a></div><form class="contact-form" data-contact-form><span class="eyebrow">SEND AN ENQUIRY</span><h3>Tell us what you need.</h3><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required placeholder="Full name"/><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="Your contact number"/><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com"/><label for="service">What can we help with?</label><select id="service" name="service"><option value="General enquiry">Select a service</option><option>Lift & Elevator Installation</option><option>Repair & Maintenance</option><option>Lift Modernization</option><option>Passenger / Goods Lift</option><option>Glass Elevator</option><option>Escalator Services</option><option>Annual Maintenance Contract</option><option>Other enquiry</option></select><label for="message">Your message</label><textarea id="message" name="message" rows="4" required placeholder="Tell us a little about your project or requirement..."></textarea><button class="button button-dark" type="submit">Prepare enquiry <span>↗</span></button><p class="form-note" data-form-note>Submitting opens your email app with the enquiry details. No information is stored on this website.</p></form></div></section>
<section class="map-section"><div class="container map-heading"><div><span class="eyebrow">FIND OUR OFFICE</span><h2>Based in North East<br/><em>Delhi, India.</em></h2></div><a class="text-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Plot+No+1-A+Khasra+No+590+Sabhapur+Extension+North+East+Delhi+110094">Open directions ↗</a></div><div class="map-frame"><iframe title="Map showing Trauzan Elevator's Sabhapur Extension address in North East Delhi" src="https://www.google.com/maps?q=Sabhapur%20Extension%2C%20North%20East%20Delhi%20110094&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></section>
</BaseLayout>
