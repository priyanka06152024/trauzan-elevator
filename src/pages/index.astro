    align-items: center;
  }

  .intro-visual {
    position: relative;
    min-height: 550px;
  }

  .intro-visual img {
    width: 100%;
    height: 550px;
    object-fit: cover;
  }

  .image-note {
    position: absolute;
    bottom: -25px;
    right: -20px;
    background: #b3945b;
    color: white;
    padding: 30px 35px;
    min-width: 230px;
  }

  .image-note span {
    font-size: 9px;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 15px;
  }

  .image-note strong {
    font-size: 24px;
    font-family: Georgia, serif;
    font-weight: 400;
    line-height: 1.35;
  }

  .intro-copy h2 {
    margin-bottom: 30px;
  }

  .intro-copy p {
    color: #77736c;
    font-size: 14px;
    margin-bottom: 22px;
  }

  .intro-copy .lead {
    font-size: 17px;
    color: #34312c;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    text-decoration: none;
    color: #a0824c;
    border-bottom: 1px solid #c9b48e;
    padding-bottom: 9px;
    font-size: 13px;
    font-weight: 600;
    transition: .3s;
  }

  .text-link:hover {
    gap: 30px;
    color: #806438;
  }

  .owner-note {
    display: flex;
    align-items: center;
    gap: 17px;
    border-top: 1px solid #e9e4da;
    margin-top: 40px;
    padding-top: 27px;
  }

  .owner-initials {
    background: #f2eee5;
    color: #a1834e;
    padding: 15px;
    font-family: Georgia, serif;
    font-size: 15px;
  }

  .owner-note strong,
  .owner-note small {
    display: block;
  }

  .owner-note strong {
    font-size: 13px;
  }

  .owner-note small {
    color: #888;
    margin-top: 5px;
  }

  /* HIGHLIGHTS */
  .stats-section {
    background: #f7f5f0;
    border-top: 1px solid #eee9df;
    border-bottom: 1px solid #eee9df;
    padding: 42px 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
  }

  .stats-grid > div {
    padding: 10px 25px;
    border-right: 1px solid #ded7c9;
  }

  .stats-grid > div:first-child {
    padding-left: 0;
  }

  .stats-grid > div:last-child {
    border: none;
  }

  .stats-number {
    color: #a78951;
    font-size: 32px;
    font-family: Georgia, serif;
  }

  .stats-grid p {
    font-size: 12px;
    color: #777;
    margin-bottom: 0;
  }

  /* SECTION HEADINGS */
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 45px;
    margin-bottom: 55px;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading > p {
    max-width: 390px;
    font-size: 14px;
    color: #77736c;
    margin-bottom: 5px;
  }

  /* SERVICES */
  .services-section {
    background: #fff;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    border-top: 1px solid #eae5db;
    border-left: 1px solid #eae5db;
  }

  .service-card {
    min-height: 220px;
    padding: 30px;
    border-right: 1px solid #eae5db;
    border-bottom: 1px solid #eae5db;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    color: inherit;
    text-decoration: none;
    transition: .45s cubic-bezier(.2,.8,.2,1);
  }

  .service-card:hover {
    background: #f8f5ee;
    transform: translateY(-6px);
    box-shadow: 0 16px 35px rgba(30,25,15,.06);
    z-index: 1;
  }

  .service-card h3 {
    font-size: 19px;
    font-weight: 500;
    margin: 0 0 12px;
  }

  .service-card p {
    color: #858078;
    font-size: 12px;
    margin: 0;
  }

  .service-arrow {
    align-self: flex-end;
    font-size: 21px;
    color: #ae9059;
    transition: .3s;
  }

  .service-card:hover .service-arrow {
    transform: translate(5px,-5px);
  }

  .section-bottom-link {
    margin-top: 38px;
    text-align: center;
  }

  /* FEATURE BAND */
  .feature-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 530px;
    background: #292721;
    color: white;
  }

  .feature-image {
    background-image:
      linear-gradient(rgba(0,0,0,.12),rgba(0,0,0,.12)),
      url('/images/elevater6.webp');
    background-size: cover;
    background-position: center;
  }

  .feature-content {
    align-self: center;
    padding: 80px 12%;
  }

  .feature-content h2 {
    font-size: clamp(35px,4vw,53px);
  }

  .feature-content h2 em {
    color: #d2b57e;
  }

  .feature-content p {
    color: rgba(255,255,255,.7);
    font-size: 14px;
    max-width: 450px;
    margin: 25px 0 35px;
  }

  /* PROCESS */
  .process-section {
    background: #faf9f6;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
  }

  .process-card {
    background: white;
    border: 1px solid #eee7dc;
    padding: 30px;
    transition: .4s;
  }

  .process-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 40px rgba(0,0,0,.06);
  }

  .process-number,
  .reason-number {
    display: block;
    color: #b3945b;
    font-family: Georgia, serif;
    font-size: 13px;
    letter-spacing: 1px;
    margin-bottom: 18px;
  }

  .process-line {
    width: 45px;
    height: 2px;
    background: #b3945b;
    margin-bottom: 28px;
    transition: width .4s ease;
  }

  .process-card:hover .process-line {
    width: 85px;
  }

  .process-card h3 {
    font-size: 17px;
    font-weight: 500;
  }

  .process-card p {
    font-size: 12px;
    color: #858078;
  }

  /* REASONS */
  .reason-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 35px;
  }

  .reason-grid article {
    border-top: 1px solid #d9c7a4;
    padding-top: 25px;
  }

  .reason-grid h3 {
    font-size: 19px;
    font-weight: 500;
    margin-top: 0;
  }

  .reason-grid p {
    color: #858078;
    font-size: 13px;
  }

  /* GALLERY */
  .gallery-preview {
    background: #f8f6f1;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 18px;
    height: 340px;
  }

  .preview-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s ease, filter .5s ease;
  }

  .preview-grid img:hover {
    transform: scale(1.025);
    filter: brightness(.9);
  }

  .disclaimer {
    font-size: 11px;
    color: #969087;
    margin-top: 20px;
  }

  /* =====================================
     TESTIMONIALS - PREMIUM LIGHT THEME
  ===================================== */

  .testimonials-section {
    position: relative;
    padding: 110px 0 95px;
    background: #f8f6f1;
    color: #302d27;
    overflow: hidden;
  }

  .testimonials-heading {
    max-width: 750px;
    margin: 0 auto 65px;
    text-align: center;
  }

  .testimonials-heading .eyebrow {
    margin-bottom: 22px;
  }

  .testimonials-heading h2 {
    font-size: clamp(36px, 4.5vw, 57px);
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -1.8px;
    margin: 0 0 22px;
    color: #302d27;
  }

  .testimonials-heading h2 em {
    color: #ad8b52;
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .testimonials-heading > p {
    max-width: 570px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.9;
    color: #817b71;
  }

  /* CARDS */

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .testimonial-card {
    position: relative;
    min-height: 355px;
    padding: 32px 30px 27px;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #eae5db;
    transition:
      transform .5s cubic-bezier(.2,.8,.2,1),
      box-shadow .5s ease,
      border-color .4s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-8px);
    border-color: #d3bd96;
    box-shadow: 0 22px 50px rgba(55, 45, 28, .075);
  }

  .testimonial-card-featured {
    background: #eee9df;
    border-color: #e4dac8;
  }

  .testimonial-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid #eae5db;
  }

  .testimonial-card-featured .testimonial-card-top {
    border-color: #dcd1be;
  }

  .testimonial-index {
    font-size: 9px;
    letter-spacing: 1.8px;
    font-weight: 600;
    color: #9b855e;
  }

  .testimonial-symbol {
    font-family: Georgia, serif;
    font-size: 55px;
    line-height: .7;
    color: #b3945b;
  }

  .testimonial-card h3 {
    max-width: 290px;
    font-size: clamp(23px, 2.1vw, 28px);
    line-height: 1.35;
    letter-spacing: -.7px;
    font-weight: 400;
    color: #302d27;
    margin: 32px 0 17px;
  }

  .testimonial-card h3 em {
    font-family: Georgia, serif;
    font-weight: 400;
    color: #ad8b52;
  }

  .testimonial-card > p {
    color: #817b71;
    font-size: 13px;
    line-height: 1.9;
    margin: 0 0 28px;
  }

  .testimonial-card-bottom {
    display: flex;
    align-items: center;
    gap: 13px;
    border-top: 1px solid #eae5db;
    padding-top: 20px;
    margin-top: auto;
  }

  .testimonial-card-featured .testimonial-card-bottom {
    border-color: #dcd1be;
  }

  .commitment-icon {
    width: 39px;
    height: 39px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: #f2eee6;
    color: #a58750;
    font-family: Georgia, serif;
    font-size: 13px;
  }

  .testimonial-card-featured .commitment-icon {
    background: #fff;
  }

  .testimonial-card-bottom strong,
  .testimonial-card-bottom small {
    display: block;
  }

  .testimonial-card-bottom strong {
    color: #39352e;
    font-size: 12px;
    font-weight: 600;
  }

  .testimonial-card-bottom small {
    color: #918a7e;
    font-size: 10px;
    margin-top: 5px;
  }

  /* CLOSING */

  .testimonial-closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    border-top: 1px solid #e3ddd1;
    margin-top: 65px;
    padding-top: 30px;
  }

  .closing-label {
    display: block;
    color: #a1834e;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.8px;
    margin-bottom: 10px;
  }

  .testimonial-closing h3 {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: 24px;
    color: #38342d;
    margin: 0;
  }

  .testimonial-contact {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    color: #9e7d46;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #cbb995;
    padding-bottom: 10px;
    white-space: nowrap;
    transition: .35s ease;
  }

  .testimonial-contact:hover {
    gap: 32px;
    color: #735a32;
  }

  /* FAQ */
  .faq-section {
    background: #f8f6f1;
    padding: 115px 0 100px;
    overflow: hidden;
  }

  .faq-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 50px;
    margin-bottom: 65px;
  }

  .faq-heading {
    max-width: 650px;
  }

  .faq-heading h2 {
    font-size: clamp(45px, 5.5vw, 70px);
    line-height: 1.05;
    letter-spacing: -2.5px;
    margin-bottom: 25px;
  }

  .faq-heading h2 em {
    color: #b3945b;
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .faq-heading > p {
    max-width: 420px;
    color: #77736c;
    font-size: 14px;
    line-height: 1.9;
  }

  .faq-contact-link {
    display: inline-flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 22px;
    text-decoration: none;
    color: #817b70;
    font-size: 12px;
  }

  .faq-contact-link span {
    color: #a1834e;
    font-size: 14px;
    font-weight: 600;
    border-bottom: 1px solid #c9b48e;
    padding-bottom: 8px;
    width: fit-content;
  }

  .faq-side-note {
    padding-bottom: 10px;
  }

  .faq-side-note p {
    color: #918979;
    font-size: 9px;
    letter-spacing: 2px;
    line-height: 1.9;
    text-align: right;
  }

  .faq-list {
    width: 100%;
    border-top: 1px solid #dcd5c8;
  }

  .faq-item {
    border-bottom: 1px solid #ded8cd;
    transition: background .4s ease;
  }

  .faq-item summary {
    min-height: 95px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    cursor: pointer;
    list-style: none;
    padding: 20px 8px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 400;
    color: #302d27;
    transition: color .3s ease;
  }

  .faq-toggle {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid #d8c9ab;
    border-radius: 50%;
    display: grid;
    place-items: center;
    position: relative;
    transition: .4s ease;
  }

  .faq-toggle span {
    position: absolute;
    width: 13px;
    height: 1px;
    background: #a1834e;
    transition: transform .4s ease;
  }

  .faq-toggle span:last-child {
    transform: rotate(90deg);
  }

  .faq-item[open] {
    background: rgba(179,148,91,.055);
  }

  .faq-item[open] .faq-toggle {
    background: #b3945b;
    border-color: #b3945b;
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-toggle span {
    background: white;
  }

  .faq-item[open] .faq-toggle span:last-child {
    transform: rotate(0);
  }

  .faq-item[open] .faq-question {
    color: #a1834e;
  }

  .faq-answer p {
    max-width: 650px;
    margin: 0 75px 28px 8px;
    color: #77736c;
    font-size: 14px;
    line-height: 1.9;
    animation: faqReveal .4s ease both;
  }

  .faq-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #dcd5c8;
    margin-top: 35px;
    padding-top: 25px;
  }

  .faq-bottom span {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: #938a7c;
  }

  .faq-bottom a {
    font-size: 11px;
    letter-spacing: 1px;
    color: #a1834e;
    text-decoration: none;
    font-weight: 600;
    transition: .3s;
  }

  .faq-bottom a:hover {
    letter-spacing: 2px;
  }

  @keyframes faqReveal {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* SCROLL REVEAL */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity .8s ease, transform .8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* TABLET */
  @media(max-width: 1000px) {
    .intro-grid {
      gap: 45px;
    }

    .process-grid,
    .reason-grid {
      grid-template-columns: repeat(2,1fr);
    }

    .trust-inner {
      flex-wrap: wrap;
    }

    .testimonial-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testimonial-card:last-child {
      grid-column: span 2;
      min-height: 300px;
    }
  }

  /* MOBILE */
  @media(max-width: 750px) {
    .section {
      padding: 75px 0;
    }

    .container {
      width: calc(100% - 36px);
    }

    .home-hero {
      height: 700px;
      min-height: 600px;
    }

    .hero-inner h1 {
      font-size: clamp(49px,10vw,70px);
      letter-spacing: -2px;
    }

    .hero-inner p {
      font-size: 13px;
      max-width: 380px;
    }

    .slider-controls {
      bottom: 22px;
    }

    .trust-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .trust-inner span {
      font-size: 9px;
    }

    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-visual,
    .intro-visual img {
      min-height: 390px;
      height: 390px;
    }

    .image-note {
      right: 0;
      bottom: -15px;
    }

    .intro-copy {
      margin-top: 25px;
    }

    .section-heading {
      display: block;
      margin-bottom: 35px;
    }

    .section-heading > p {
      margin-top: 20px;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 25px;
    }

    .stats-grid > div {
      padding: 10px 15px;
    }

    .stats-grid > div:nth-child(2) {
      border-right: none;
    }

    .service-grid {
      grid-template-columns: 1fr 1fr;
    }

    .service-card {
      min-height: 210px;
      padding: 20px;
    }

    .feature-band {
      grid-template-columns: 1fr;
    }

    .feature-image {
      min-height: 300px;
    }

    .feature-content {
      padding: 55px 25px;
    }

    .preview-grid {
      height: auto;
      grid-template-columns: 1fr 1fr;
    }

    .preview-grid img {
      height: 230px;
    }

    .preview-grid img:first-child {
      grid-column: span 2;
      height: 270px;
    }

    /* TESTIMONIALS MOBILE */

    .testimonials-section {
      padding: 75px 0 65px;
    }

    .testimonials-heading {
      margin-bottom: 40px;
    }

    .testimonials-heading h2 {
      font-size: clamp(34px, 8vw, 45px);
      letter-spacing: -1px;
    }

    .testimonials-heading > p {
      font-size: 13px;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .testimonial-card,
    .testimonial-card:last-child {
      grid-column: auto;
      min-height: 310px;
      padding: 27px 24px;
    }

    .testimonial-card h3 {
      font-size: 26px;
      margin-top: 27px;
    }

    .testimonial-closing {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 40px;
      gap: 22px;
    }

    .testimonial-closing h3 {
      font-size: 21px;
    }

    .faq-top {
      margin-bottom: 45px;
    }

    .faq-side-note {
      display: none;
    }

    .faq-item summary {
      min-height: 85px;
    }

    .faq-answer p {
      margin: 0 45px 25px 8px;
      font-size: 13px;
    }
  }

  @media(max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-actions .button {
      min-width: 205px;
    }

    .slide-dots {
      gap: 5px;
    }

    .slide-dots button {
      width: 15px;
    }

    .slide-dots button.is-active {
      width: 28px;
    }

    .slide-arrows button {
      height: 36px;
      width: 36px;
    }

    .service-grid,
    .process-grid,
    .reason-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 175px;
    }

    .preview-grid img {
      height: 170px;
    }

    .preview-grid img:first-child {
      height: 210px;
    }

    .testimonials-heading h2 {
      font-size: 35px;
    }

    .testimonial-card,
    .testimonial-card:last-child {
      min-height: 300px;
      padding: 24px 21px;
    }

    .testimonial-card h3 {
      font-size: 25px;
    }

    .testimonial-card > p {
      font-size: 12px;
    }

    .faq-section {
      padding: 70px 0;
    }

    .faq-heading h2 {
      font-size: 45px;
      line-height: 1.1;
    }

    .faq-heading > p {
      font-size: 13px;
    }

    .faq-item summary {
      min-height: 80px;
      gap: 12px;
    }

    .faq-question {
      font-size: 14px;
      line-height: 1.5;
    }

    .faq-toggle {
      width: 34px;
      height: 34px;
    }

    .faq-answer p {
      margin: 0 35px 23px 8px;
      font-size: 12px;
