    height: min(790px, 90vh);
    min-height: 610px;
    position: relative;
    background: #24221e;
    color: white;
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 1s;
  }

